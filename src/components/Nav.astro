---
import { NAV, ISSUE, ISSUE_NOTE } from '../consts';
import { withBase } from '../lib/url';

const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return path === withBase('/') || path === withBase('');
  return path.startsWith(withBase(href));
};
---

<header class="masthead">
  <div class="sprocket" aria-hidden="true"></div>

  <div class="mast-row">
    <a class="brand" href={withBase('/')} aria-label="返回首页">
      <span class="brand-cn">放映手册</span>
      <span class="brand-en">Duanjhui&rsquo;s Program</span>
    </a>

    <nav class="nav" aria-label="主导航">
      {NAV.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={['nav-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="no">{item.no}</span>{item.label}
        </a>
      ))}
    </nav>
  </div>

  <div class="mast-meta" aria-hidden="true">
    <span>{ISSUE}</span>
    <span class="sep">/</span>
    <span>2026</span>
    <span class="sep">/</span>
    <span>{ISSUE_NOTE}</span>
  </div>
</header>

<style>
  .sprocket {
    height: 14px;
    margin: 0 calc(var(--gutter) * -1);
    background-color: var(--strip);
    background-image: radial-gradient(
      circle at 50% 50%,
      var(--strip-hole) 2.2px,
      transparent 2.7px
    );
    background-size: 24px 14px;
    background-position: center;
    background-repeat: repeat-x;
  }

  .mast-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 18px;
    padding: 22px 0 12px;
    border-bottom: 2px solid var(--rule-strong);
  }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand:hover {
    color: inherit;
  }

  .brand-cn {
    font-family: var(--font-serif);
    font-size: 1.32rem;
    letter-spacing: 0.24em;
  }

  .brand-en {
    margin-top: 0.5em;
    font-size: 0.58rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 18px;
  }

  .nav-link {
    padding-bottom: 2px;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    border-bottom: 1px solid transparent;
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--red);
  }

  .nav-link .no {
    margin-right: 0.35em;
    font-family: var(--font-serif);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--red);
  }

  .nav-link.active {
    color: var(--ink);
    border-bottom-color: var(--red);
  }

  .mast-meta {
    display: flex;
    gap: 9px;
    padding-top: 9px;
    font-size: 0.62rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .mast-meta .sep {
    color: var(--rule-strong);
  }

  @media (max-width: 620px) {
    .mast-row {
      align-items: flex-start;
      padding-top: 18px;
    }

    .nav {
      gap: 14px;
    }

    .nav-link {
      font-size: 0.78rem;
      letter-spacing: 0.06em;
    }

    .mast-meta {
      font-size: 0.56rem;
      letter-spacing: 0.18em;
    }
  }
</style>
