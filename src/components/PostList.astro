---
import { withBase } from '../lib/url';
import { tagKey } from '../lib/posts';
import { formatDate } from '../lib/posts';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p class="muted" style="padding:20px 0">还没有文章。</p>}

<ul class="post-index">
  {posts.map((post, i) => (
    <li class="post-item">
      <span class="post-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <div class="post-body">
        <a href={withBase(`/posts/${post.id}/`)}>
          <h3 class="post-title">{post.data.title}</h3>
        </a>
        <div class="post-meta">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {post.data.tags.map((tag) => (
            <a class="tag-chip" href={withBase(`/tags/${tagKey(tag)}/`)}>#{tag}</a>
          ))}
        </div>
        {post.data.description && <p class="post-desc">{post.data.description}</p>}
      </div>
    </li>
  ))}
</ul>
