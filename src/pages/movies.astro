---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MOVIES } from '../data/movies';
import { withBase } from '../lib/url';
---

<BaseLayout title="观影" description="看过的电影和剧，点开卡片看解说。">
  <header class="page-head">
    <p class="kicker">贰 · 放映厅</p>
    <h1>观影</h1>
    <p class="page-sub">
      本期 {MOVIES.length} 部 · 点卡片切换，也可以用方向键或左右滑动
    </p>
  </header>

  <hr class="head-rule" />

  <section class="cinema">
    <div class="cf" id="cf" tabindex="0" role="group" aria-label="观影卡片墙，左右方向键切换，回车展开解说">
      <div class="cf-glow" aria-hidden="true"></div>
      {MOVIES.map((m, i) => (
        <button
          class="cf-card"
          type="button"
          data-i={i}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={`${m.title}，${m.kind}，${m.year} 年`}
          style={`--glowc:${m.bgDark}`}
        >
          <img
            class="cf-img"
            src={withBase(m.poster)}
            alt=""
            loading={i === 0 ? 'eager' : 'lazy'}
            draggable="false"
          />
          <span class="cf-shade" aria-hidden="true"></span>
          <span class="cf-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="cf-info">
            <span class="cf-title">{m.title}</span>
            <span class="cf-meta">{m.year} · {m.kind}</span>
          </span>
        </button>
      ))}
    </div>

    <div class="cf-ctrl">
      <button id="cf-prev" type="button" aria-label="上一部">‹</button>
      <span class="cf-pos" id="cf-pos">1 / {MOVIES.length}</span>
      <button id="cf-next" type="button" aria-label="下一部">›</button>
    </div>
  </section>

  <section class="cf-detail" id="cf-detail" aria-live="polite">
    {MOVIES.map((m, i) => (
      <article class="cf-panel" data-i={i} hidden={i !== 0}>
        <p class="cf-panel-kicker">Note · {m.kind}</p>
        <h2 class="cf-panel-title">{m.title}</h2>
        <p class="cf-panel-meta">{m.year} 年 · {m.kind}</p>
        <p class="cf-desc">{m.desc}</p>
      </article>
    ))}
  </section>

  <p class="cf-foot">看完一部就补一段，慢慢攒成自己的片单。</p>
</BaseLayout>

<script type="application/json" id="cf-data" set:html={JSON.stringify(MOVIES)}></script>

<style is:global>
  /* 影院区：通栏、永远暗场，银幕在上、场刊解说在纸上 */
  .cinema {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background:
      radial-gradient(120% 90% at 50% 30%, #131826 0%, #0a0d15 46%, #05070c 100%);
    padding-bottom: 4px;
    overflow: hidden;
  }

  .cf {
    position: relative;
    height: 560px;
    perspective: 1500px;
    perspective-origin: 50% 42%;
    user-select: none;
    touch-action: pan-y;
    outline: none;
    overflow: hidden;
  }

  .cf:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: -4px;
  }

  /* 环境光晕：颜色跟随当前卡片，JS 写入 --glow */
  .cf-glow {
    position: absolute;
    left: 50%;
    top: 44%;
    width: min(1300px, 96vw);
    height: 460px;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      closest-side,
      var(--glow, transparent) 0%,
      transparent 72%
    );
    filter: blur(8px);
    opacity: 0.5;
    pointer-events: none;
  }

  .cf-card {
    position: absolute;
    left: 50%;
    top: 47%;
    width: 244px;
    height: 356px;
    margin: -178px 0 0 -122px;
    padding: 0;
    border: none;
    border-radius: 8px;
    background: #10131b;
    cursor: pointer;
    overflow: visible;
    will-change: transform;
    transition:
      transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.45s ease,
      box-shadow 0.4s ease,
      filter 0.4s ease;
    /* 地面倒影：仅 WebKit 内核生效，其他浏览器自动降级为无倒影 */
    -webkit-box-reflect: below 14px
      linear-gradient(transparent 62%, rgba(255, 255, 255, 0.18));
  }

  .cf-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
    pointer-events: none;
    filter: brightness(0.62) saturate(0.85);
    transition: filter 0.4s ease;
  }

  /* 当前卡片：画面全亮 + 白色发光描边 */
  .cf-card[aria-pressed='true'] {
    box-shadow:
      0 0 0 2px rgba(255, 255, 255, 0.92),
      0 0 30px rgba(255, 255, 255, 0.32),
      0 34px 70px rgba(0, 0, 0, 0.72);
  }

  .cf-card[aria-pressed='true'] .cf-img {
    filter: brightness(1) saturate(1.05);
  }

  .cf-card:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 4px;
  }

  .cf-shade {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: linear-gradient(
      to top,
      rgba(4, 6, 10, 0.82) 0%,
      rgba(4, 6, 10, 0.35) 34%,
      transparent 58%
    );
    pointer-events: none;
  }

  .cf-no {
    position: absolute;
    top: 10px;
    right: 12px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.78);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
    pointer-events: none;
  }

  .cf-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 12px 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    pointer-events: none;
  }

  .cf-title {
    font-family: var(--font-serif);
    font-size: 1.42rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #fff;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.65);
  }

  .cf-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.66);
  }

  .cf-ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 2px 0 16px;
  }

  .cf-ctrl button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: none;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .cf-ctrl button:hover {
    border-color: var(--red);
    color: #fff;
  }

  .cf-pos {
    min-width: 56px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.55);
  }

  .cf-detail {
    margin-top: 22px;
    padding: 18px 0 4px 18px;
    border-left: 2px solid var(--red);
    border-top: 1px solid var(--rule);
    min-height: 150px;
  }

  .cf-panel {
    animation: cf-in 0.35s ease both;
  }

  .cf-panel[hidden] {
    display: none;
  }

  .cf-panel-kicker {
    margin: 0 0 4px;
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--red);
  }

  .cf-panel-title {
    margin: 0 0 2px;
    font-size: 1.38rem;
    letter-spacing: 0.03em;
  }

  .cf-panel-meta {
    margin: 0 0 10px;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .cf-desc {
    margin: 0;
    max-width: 62ch;
    font-size: 0.94rem;
    line-height: 1.95;
  }

  .cf-foot {
    margin: 18px 0 0;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  @keyframes cf-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .cf {
      height: 400px;
      perspective: 900px;
    }

    .cf-glow {
      height: 320px;
    }

    .cf-card {
      width: 164px;
      height: 240px;
      margin: -120px 0 0 -82px;
    }

    .cf-title {
      font-size: 1.1rem;
    }

    .cf-detail {
      padding-left: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-card {
      transition: none;
    }

    .cf-panel {
      animation: none;
    }
  }
</style>

<script>
  const raw = document.getElementById('cf-data');
  const data = raw ? JSON.parse(raw.textContent || '[]') : [];
  const stage = document.getElementById('cf');
  const posEl = document.getElementById('cf-pos');

  if (stage && data.length > 0) {
    const cards = Array.from(stage.querySelectorAll<HTMLButtonElement>('.cf-card'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.cf-panel'));
    const prevBtn = document.getElementById('cf-prev');
    const nextBtn = document.getElementById('cf-next');
    let active = 0;

    const hexToRgba = (hex: string, alpha: number) => {
      const n = parseInt(hex.replace('#', ''), 16);
      const r = (n >> 16) & 255;
      const g = (n >> 8) & 255;
      const b = n & 255;
      return `rgba(${r},${g},${b},${alpha})`;
    };

    // 影院永远是暗场，光晕统一用每部片的暗色配置
    const updateGlow = () => {
      const m = data[active];
      stage.style.setProperty('--glow', hexToRgba(m.bgDark, 0.55));
    };

    const layout = () => {
      const narrow = stage.clientWidth < 560;
      const step = narrow ? 96 : 212;
      cards.forEach((card, i) => {
        // 环形排布：把超出半圈的卡片绕到另一侧，保证两侧始终饱满
        const n = data.length;
        let off = i - active;
        if (off > n / 2) off -= n;
        if (off < -n / 2) off += n;
        const abs = Math.abs(off);
        const x = off * step;
        const ry = Math.max(-50, Math.min(50, -off * 24));
        const sc = Math.max(0.72, 1 - abs * 0.07);
        const op = abs > 3 ? 0 : 1 - Math.min(abs * 0.12, 0.4);
        const y = off === 0 ? -10 : 8;
        card.style.transform = `translate(${x}px, ${y}px) rotateY(${ry}deg) scale(${sc})`;
        card.style.zIndex = String(20 - abs);
        card.style.opacity = String(op);
        card.style.pointerEvents = op === 0 ? 'none' : 'auto';
        card.setAttribute('aria-pressed', i === active ? 'true' : 'false');
      });
      panels.forEach((p, i) => {
        p.hidden = i !== active;
      });
      if (posEl) posEl.textContent = `${active + 1} / ${data.length}`;
      updateGlow();
    };

    const go = (i: number) => {
      active = (i + data.length) % data.length;
      layout();
    };

    cards.forEach((card, i) => card.addEventListener('click', () => go(i)));
    prevBtn?.addEventListener('click', () => go(active - 1));
    nextBtn?.addEventListener('click', () => go(active + 1));

    stage.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(active - 1);
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(active + 1);
      }
    });

    let startX: number | null = null;
    stage.addEventListener('pointerdown', (e: PointerEvent) => {
      startX = e.clientX;
    });
    stage.addEventListener('pointerup', (e: PointerEvent) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 45) go(active + (dx < 0 ? 1 : -1));
    });

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(layout, 120);
    });

    layout();
  }
</script>
