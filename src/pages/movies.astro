---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MOVIES } from '../data/movies';
---

<BaseLayout title="观影" description="看过的电影和剧，点开卡片看解说。">
  <header class="page-head">
    <p class="kicker">贰 · 放映厅</p>
    <h1>观影</h1>
    <p class="page-sub">
      本期 {MOVIES.length} 部 · 点卡片切换，也可以用方向键或左右滑动
    </p>
  </header>

  <hr class="head-rule" />

  <div class="cf" id="cf" tabindex="0" role="group" aria-label="观影卡片墙，左右方向键切换，回车展开解说">
    <div class="cf-glow" aria-hidden="true"></div>
    {MOVIES.map((m, i) => (
      <button
        class="cf-card"
        type="button"
        data-i={i}
        aria-pressed={i === 0 ? 'true' : 'false'}
        aria-label={`${m.title}，${m.kind}，${m.year} 年`}
        style={`--bg:${m.bg};--fg:${m.fg};--bgd:${m.bgDark};--fgd:${m.fgDark}`}
      >
        <span class="cf-top">
          <span class="cf-kind">{m.kind}</span>
          <span class="cf-no">{String(i + 1).padStart(2, '0')}</span>
        </span>
        <span class="cf-title">{m.title}</span>
        <span class="cf-year">{m.year}</span>
      </button>
    ))}
  </div>

  <div class="cf-ctrl">
    <button id="cf-prev" type="button" aria-label="上一部">‹</button>
    <span class="cf-pos" id="cf-pos">1 / {MOVIES.length}</span>
    <button id="cf-next" type="button" aria-label="下一部">›</button>
  </div>

  <section class="cf-detail" id="cf-detail" aria-live="polite">
    {MOVIES.map((m, i) => (
      <article class="cf-panel" data-i={i} hidden={i !== 0}>
        <p class="cf-panel-kicker">Note · {m.kind}</p>
        <h2 class="cf-panel-title">{m.title}</h2>
        <p class="cf-panel-meta">{m.year} 年 · {m.kind}</p>
        <p class="cf-desc">{m.desc}</p>
      </article>
    ))}
  </section>

  <p class="cf-foot">看完一部就补一段，慢慢攒成自己的片单。</p>
</BaseLayout>

<script type="application/json" id="cf-data" set:html={JSON.stringify(MOVIES)}></script>

<style is:global>
  /* 通栏舞台：横贯整个浏览器宽度 */
  .cf {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 480px;
    margin-top: 8px;
    perspective: 1500px;
    perspective-origin: 50% 42%;
    user-select: none;
    touch-action: pan-y;
    outline: none;
    overflow: hidden;
  }

  .cf:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: -4px;
  }

  /* 环境光晕：颜色跟随当前卡片，JS 写入 --glow */
  .cf-glow {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(1200px, 92vw);
    height: 400px;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      closest-side,
      var(--glow, transparent) 0%,
      transparent 72%
    );
    filter: blur(6px);
    opacity: 0.55;
    pointer-events: none;
  }

  .cf-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 238px;
    height: 344px;
    margin: -172px 0 0 -119px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-align: left;
    font-family: var(--font-sans);
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
    overflow: hidden;
    will-change: transform;
    transition:
      transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 0.45s ease,
      box-shadow 0.4s ease;
  }

  html[data-theme='dark'] .cf-card {
    background: var(--bgd);
    color: var(--fgd);
  }

  .cf-card[aria-pressed='true'] {
    box-shadow: 0 28px 64px rgba(60, 40, 25, 0.26);
  }

  html[data-theme='dark'] .cf-card[aria-pressed='true'] {
    box-shadow: 0 28px 64px rgba(0, 0, 0, 0.65);
  }

  .cf-card:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 4px;
  }

  .cf-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .cf-kind {
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    opacity: 0.75;
  }

  .cf-no {
    font-family: var(--font-serif);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    opacity: 0.5;
  }

  .cf-title {
    font-family: var(--font-serif);
    font-size: 1.72rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.04em;
  }

  .cf-year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    opacity: 0.6;
  }

  .cf-ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 6px 0 10px;
  }

  .cf-ctrl button {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    background: none;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .cf-ctrl button:hover {
    border-color: var(--red);
    color: var(--red);
  }

  .cf-pos {
    min-width: 56px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .cf-detail {
    margin-top: 22px;
    padding: 18px 0 4px 18px;
    border-left: 2px solid var(--red);
    border-top: 1px solid var(--rule);
    min-height: 150px;
  }

  .cf-panel {
    animation: cf-in 0.35s ease both;
  }

  .cf-panel[hidden] {
    display: none;
  }

  .cf-panel-kicker {
    margin: 0 0 4px;
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--red);
  }

  .cf-panel-title {
    margin: 0 0 2px;
    font-size: 1.38rem;
    letter-spacing: 0.03em;
  }

  .cf-panel-meta {
    margin: 0 0 10px;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .cf-desc {
    margin: 0;
    max-width: 62ch;
    font-size: 0.94rem;
    line-height: 1.95;
  }

  .cf-foot {
    margin: 18px 0 0;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  @keyframes cf-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 560px) {
    .cf {
      height: 350px;
      perspective: 900px;
    }

    .cf-glow {
      height: 280px;
    }

    .cf-card {
      width: 152px;
      height: 220px;
      margin: -110px 0 0 -76px;
      padding: 14px;
    }

    .cf-title {
      font-size: 1.3rem;
    }

    .cf-detail {
      padding-left: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-card {
      transition: none;
    }

    .cf-panel {
      animation: none;
    }
  }
</style>

<script>
  const raw = document.getElementById('cf-data');
  const data = raw ? JSON.parse(raw.textContent || '[]') : [];
  const stage = document.getElementById('cf');
  const posEl = document.getElementById('cf-pos');

  if (stage && data.length > 0) {
    const cards = Array.from(stage.querySelectorAll<HTMLButtonElement>('.cf-card'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.cf-panel'));
    const prevBtn = document.getElementById('cf-prev');
    const nextBtn = document.getElementById('cf-next');
    let active = 0;

    const hexToRgba = (hex: string, alpha: number) => {
      const n = parseInt(hex.replace('#', ''), 16);
      const r = (n >> 16) & 255;
      const g = (n >> 8) & 255;
      const b = n & 255;
      return `rgba(${r},${g},${b},${alpha})`;
    };

    const updateGlow = () => {
      const m = data[active];
      const dark = document.documentElement.dataset.theme === 'dark';
      stage.style.setProperty(
        '--glow',
        hexToRgba(dark ? m.bgDark : m.bg, dark ? 0.42 : 0.6)
      );
    };

    const layout = () => {
      const narrow = stage.clientWidth < 560;
      const step = narrow ? 84 : 192;
      cards.forEach((card, i) => {
        // 环形排布：把超出半圈的卡片绕到另一侧，保证两侧始终饱满
        const n = data.length;
        let off = i - active;
        if (off > n / 2) off -= n;
        if (off < -n / 2) off += n;
        const abs = Math.abs(off);
        const x = off * step;
        const ry = Math.max(-50, Math.min(50, -off * 24));
        const sc = Math.max(0.72, 1 - abs * 0.07);
        const op = abs > 3 ? 0 : 1 - Math.min(abs * 0.12, 0.4);
        const y = off === 0 ? -10 : 8;
        card.style.transform = `translate(${x}px, ${y}px) rotateY(${ry}deg) scale(${sc})`;
        card.style.zIndex = String(20 - abs);
        card.style.opacity = String(op);
        card.style.pointerEvents = op === 0 ? 'none' : 'auto';
        card.setAttribute('aria-pressed', i === active ? 'true' : 'false');
      });
      panels.forEach((p, i) => {
        p.hidden = i !== active;
      });
      if (posEl) posEl.textContent = `${active + 1} / ${data.length}`;
      updateGlow();
    };

    const go = (i: number) => {
      active = (i + data.length) % data.length;
      layout();
    };

    cards.forEach((card, i) => card.addEventListener('click', () => go(i)));
    prevBtn?.addEventListener('click', () => go(active - 1));
    nextBtn?.addEventListener('click', () => go(active + 1));

    stage.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(active - 1);
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(active + 1);
      }
    });

    let startX: number | null = null;
    stage.addEventListener('pointerdown', (e: PointerEvent) => {
      startX = e.clientX;
    });
    stage.addEventListener('pointerup', (e: PointerEvent) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 45) go(active + (dx < 0 ? 1 : -1));
    });

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(layout, 120);
    });

    // 暗色模式切换时同步光晕颜色
    new MutationObserver(updateGlow).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    layout();
  }
</script>
