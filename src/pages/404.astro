---
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="本场已散">
  <section class="notfound">
    <p class="kicker">No Such Screening</p>
    <p class="code" aria-hidden="true">404</p>
    <h1>本场已散</h1>
    <p class="muted">这个地址不存在——可能文章还没写，或者票根上的座位号抄错了。</p>
    <a class="back-ticket" href={withBase('/')}>回到目录</a>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding: 64px 0 40px;
    text-align: center;
  }

  .code {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(4.5rem, 18vw, 8rem);
    line-height: 0.9;
    letter-spacing: 0.06em;
    color: var(--red);
    opacity: 0.9;
  }

  .notfound h1 {
    margin: 18px 0 10px;
    font-size: 1.5rem;
    letter-spacing: 0.2em;
  }

  .notfound .muted {
    max-width: 34ch;
    margin: 0 auto 26px;
    line-height: 1.9;
  }

  .back-ticket {
    display: inline-block;
    padding: 9px 22px;
    background: var(--red);
    color: #fbf4e8;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
  }

  .back-ticket:hover {
    color: #fff;
    background: var(--red-deep);
  }
</style>
