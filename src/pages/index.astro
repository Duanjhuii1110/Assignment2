---
import { getPublishedPosts } from '../lib/posts';
import { NAV } from '../consts';
import { MOVIES } from '../data/movies';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';

const posts = await getPublishedPosts();
const articleNav = NAV[0];
---

<BaseLayout>
  <section class="hero">
    <p class="kicker">个人放映手册 · Issue 01</p>
    <h1>把看过的，<br />都留下来<span class="dot">。</span></h1>
    <p class="hero-lead">
      银幕上散场了，纸上才刚刚开始。这里放电影、课程和日子的记录——看过什么，想到什么，都留一行。
    </p>
  </section>

  <a class="ticket" href={withBase('/movies/')}>
    <span class="ticket-main">
      <span class="ticket-kicker">Admit One · 本期片单</span>
      <span class="ticket-title">观影入场券</span>
      <span class="ticket-sub">{MOVIES.length} 部影片 · 点开卡片读解说</span>
    </span>
    <span class="ticket-stub" aria-hidden="true">
      <span>NO.</span>
      <span class="ticket-no">001</span>
    </span>
  </a>

  <div class="section-head">
    <h2>{articleNav.no} · 文章目录</h2>
    <span class="count">{posts.length} 篇</span>
  </div>

  <PostList posts={posts} />
</BaseLayout>

<style>
  .hero {
    padding: 42px 0 6px;
  }

  .hero h1 {
    margin: 0 0 0.55em;
    font-size: clamp(2.25rem, 7.4vw, 3.8rem);
    line-height: 1.24;
    letter-spacing: 0.02em;
    font-weight: 600;
  }

  .hero h1 .dot {
    color: var(--red);
  }

  .hero-lead {
    max-width: 46ch;
    margin: 0;
    padding-left: 14px;
    border-left: 2px solid var(--red);
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.95;
  }

  /* 票根：左侧正文，右侧虚线撕口 + 座号 */
  .ticket {
    position: relative;
    display: flex;
    align-items: stretch;
    margin: 30px 0 4px;
    background: var(--red);
    color: #fbf4e8;
    box-shadow: var(--shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .ticket:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 20px 42px rgba(70, 48, 28, 0.18);
  }

  .ticket-main {
    flex: 1;
    min-width: 0;
    padding: 18px 22px 20px;
  }

  .ticket-kicker {
    display: block;
    margin-bottom: 0.6em;
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.82;
  }

  .ticket-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.55rem;
    line-height: 1.3;
    letter-spacing: 0.08em;
  }

  .ticket-sub {
    display: block;
    margin-top: 0.55em;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    opacity: 0.86;
  }

  .ticket-stub {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25em;
    width: 104px;
    flex-shrink: 0;
    border-left: 1px dashed rgba(251, 244, 232, 0.55);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    opacity: 0.92;
  }

  .ticket-no {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    letter-spacing: 0.12em;
  }

  /* 撕口的两个半圆 */
  .ticket::before,
  .ticket::after {
    content: '';
    position: absolute;
    left: calc(100% - 111px);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--paper);
  }

  .ticket::before {
    top: -7px;
  }

  .ticket::after {
    bottom: -7px;
  }

  @media (max-width: 620px) {
    .hero {
      padding-top: 30px;
    }

    .hero-lead {
      font-size: 0.9rem;
    }

    .ticket-stub {
      width: 76px;
    }

    .ticket-main {
      padding: 16px 18px;
    }

    .ticket-title {
      font-size: 1.28rem;
    }

    .ticket-sub {
      font-size: 0.72rem;
    }

    .ticket::before,
    .ticket::after {
      left: calc(100% - 83px);
      width: 12px;
      height: 12px;
    }

    .ticket::before {
      top: -6px;
    }

    .ticket::after {
      bottom: -6px;
    }
  }
</style>
