---
import { getPublishedPosts, collectTags, tagKey } from '../../lib/posts';
import { withBase } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';

const tags = collectTags(await getPublishedPosts());
---

<BaseLayout title="标签">
  <header class="page-head">
    <p class="kicker">档案 · 索引</p>
    <h1>标签</h1>
    <p class="page-sub">共 {tags.length} 个标签 · <a class="sub-link" href={withBase('/archive/')}>按时间看</a></p>
  </header>

  <hr class="head-rule" />

  <div class="tag-grid">
    {tags.map(({ tag, count }) => (
      <a class="tag-box" href={withBase(`/tags/${tagKey(tag)}/`)}>
        <span class="tag-name">#{tag}</span>
        <span class="tag-count">{String(count).padStart(2, '0')}</span>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .sub-link {
    color: var(--red);
    border-bottom: 1px solid rgba(174, 43, 31, 0.3);
  }

  .sub-link:hover {
    border-bottom-color: var(--red);
    text-decoration: none;
  }

  .tag-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
  }

  .tag-box {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    background: var(--card);
  }

  .tag-box:hover {
    border-color: var(--red);
    color: var(--red);
  }

  .tag-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .tag-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-soft);
  }
</style>
